@page "/"
@rendermode InteractiveServer
@inject ChatSession Session
@implements IDisposable

<PageTitle>AiChat</PageTitle>

<div class="studio">
    <header class="studio-header">
        <div class="studio-brand">AiChat</div>
        <button type="button"
                class="studio-ghost"
                @onclick="Clear"
                disabled="@Session.IsStreaming">
            New chat
        </button>
    </header>

    <div class="studio-scroll">
        <div class="studio-column">
            @if (Session.Messages.Count == 0)
            {
                <div class="studio-empty">
                    <h1>Start a conversation</h1>
                    <p>Ask a question, draft something, or think out loud.</p>
                </div>
            }
            else
            {
                <div class="studio-transcript" aria-live="polite">
                    @foreach (var message in Session.Messages)
                    {
                        if (message.Role == ChatRole.User)
                        {
                            <div class="msg msg-user">
                                <div class="msg-bubble">@message.Content</div>
                            </div>
                        }
                        else
                        {
                            <div class="msg msg-assistant">
                                <div class="msg-mark" aria-hidden="true"></div>
                                <div class="msg-body">
                                    <MarkdownView Content="@message.Content"
                                                  ShowCaret="@(Session.IsStreaming && message == Session.Messages[^1])" />
                                </div>
                            </div>
                        }
                    }
                </div>
            }

            @if (!string.IsNullOrEmpty(Session.Error))
            {
                <div class="studio-error" role="alert">@Session.Error</div>
            }
        </div>
    </div>

    <div class="studio-dock">
        <form class="studio-composer" @onsubmit="SendAsync" @onsubmit:preventDefault>
            <textarea rows="1"
                      placeholder="Message…"
                      aria-label="Message"
                      @bind="_draft"
                      @bind:event="oninput"
                      @onkeydown="OnKeyDown"
                      disabled="@Session.IsStreaming"></textarea>

            @if (Session.IsStreaming)
            {
                <button type="button"
                        class="studio-action studio-stop"
                        @onclick="Cancel"
                        aria-label="Stop generating">
                    <span class="studio-stop-icon" aria-hidden="true"></span>
                </button>
            }
            else
            {
                <button type="submit"
                        class="studio-action studio-send"
                        disabled="@string.IsNullOrWhiteSpace(_draft)"
                        aria-label="Send message">
                    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none">
                        <path d="M5 12h12M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </button>
            }
        </form>
        <p class="studio-hint">Enter to send · Shift+Enter for a new line</p>
    </div>
</div>

@code {
    private string _draft = string.Empty;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private async Task SendAsync()
    {
        var text = _draft;
        _draft = string.Empty;
        await Session.SendAsync(text);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !Session.IsStreaming && !string.IsNullOrWhiteSpace(_draft))
        {
            await SendAsync();
        }
    }

    private void Cancel() => Session.Cancel();

    private void Clear() => Session.Clear();

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
